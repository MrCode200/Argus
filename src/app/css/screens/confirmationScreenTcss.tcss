ConfirmationScreen {
    align: center middle;
    #dialog {
        border: thick $primary 40%;
        width: 80;
        height: auto;
        padding: 2 4;
        box-sizing: border-box;
        background: $surface;
    }

    #title {
        width: 100%;
        text-align: center;
        margin: 0 0 1 0;
        text-style: bold underline;
    }

    #image-center {
        offset-x: 9.2%;
        border: round $primary 40%;
        height: 20;
        width: 85%;
    }

    #prompt {
        width: 100%;
        text-align: center;
        text-style: bold;
        padding: 1 0 2 0;
    }

    HorizontalGroup {
        align: center middle;
    }

    Button {
        margin: 0 5 0 5;
    }

    #red_btn {
        width: 1fr;
    }

    #green_btn {
        width: 1fr;
    }
}
