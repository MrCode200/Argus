FilteredFilePickerScreen {
    align: center middle;

    #dialog {
        width: auto;
        max-width: 110;
        align: center middle;
        offset: 15% 0%;

        #select_file_dialog {
            width: auto;
            max_width: 60;
            height: auto;
            border: tall pink 20%;
            background: $surface;
            padding: 1 2;

            #title {
                text-style: bold;
                color: $text;
                margin-bottom: 1;
                text-align: center;
                width: 100%;
            }

            #search-input {
                margin-bottom: 1;
                width: 100%;
                background: grey 10%;
            }

            FilteredDirectoryTree {
                height: auto;
                min_height: 15;
                padding: 1 2;
                margin: 1 2;
                background: grey 20%;
            }

            #status-bar {
                margin-top: 1;
                margin-bottom: 1;
                text-align: center;
                width: 100%;
                text-style: reverse;
            }

            #button-container {
                align: center middle;

                Button {
                    width: auto;
                }

                #cancel {
                    margin: 0 1 0 0;
                }
                #select {
                    margin: 0 0 0 1;
                }
            }
        }

        #radio_set_container {
            width: auto;
            height: auto;
            align: center middle;
            background: grey 15%;
            offset: -3% 0%;
        }

        #placeholder_grid {
            offset: 0% 0%;
            width: auto;
            height: 31;
            hatch: left $error 40%;
            content-align: center middle;
            text-align: center;
            text-style: bold;
            color: $error;
        }

        #target_radio_set {
            width: auto;
            height: auto;

            RadioButton {
                width: auto;
                padding: 0 1;
            }
        }

    }
}
